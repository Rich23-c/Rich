@echo off
chcp 65001 > nul
title ร้านขนมแม้ว - ระบบเปิดร้านออนไลน์
echo ====================================================
echo   🐾 กำลังเริ่มต้นเปิดร้านขนมแม้ว (Snack by Maew)
echo ====================================================
echo.

cd /d "%~dp0"

echo 1. กำลังเปิดเซิร์ฟเวอร์ร้านขนมแม้ว...
taskkill /f /im node.exe > nul 2>&1
start "" /b node server.js

timeout /t 3 > nul

echo 2. กำลังสร้างลิงก์ออนไลน์สาธารณะ (Cloudflare Tunnel)...
echo ====================================================
echo  📌 ลิงก์สาธารณะจะปรากฏด้านล่าง (https://....trycloudflare.com)
echo     - ก๊อปลิงก์ส่งให้ลูกค้าสั่งซื้อได้เลย
echo     - เข้าหลังบ้านให้เติม /admin ต่อท้ายลิงก์ (รหัส PIN: 411197)
echo  ⚠️  ห้ามปิดหน้าต่างนี้ระหว่างเปิดร้าน หากปิดเว็บจะดับ
echo ====================================================
echo.

cloudflared.exe tunnel --url http://localhost:3000
pause